<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\Entry;

class EntryController extends Controller
{
    // Show the form to enter multiple labels and amounts
    public function create()
    {
        return view('entries.create');
    }

    // Store the labels and amounts as JSON
    public function store(Request $request)
    {
        $validated = $request->validate([
            'label' => 'required|array|min:1',
            'amount' => 'required|array|min:1',
            'label.*' => 'required|string',
            'amount.*' => 'required|numeric|min:0.01',
        ]);

        // Combine label and amount into an array of entries
        $entries = [];
        foreach ($validated['label'] as $index => $label) {
            $entries[] = [
                'label' => $label,
                'amount' => $validated['amount'][$index],
            ];
        }

        // Store as JSON in the database
        Entry::create(['data' => $entries]);

        return redirect()->route('entries.index')->with('success', 'Entries saved successfully!');
    }

    // Show all stored entries
    public function index()
    {
        $entries = Entry::all();
        return view('entries.index', compact('entries'));
    }

    // Show the edit form for a specific entry
    public function edit($id)
    {
        $entry = Entry::findOrFail($id);
        return view('entries.edit', compact('entry'));
    }

    // Update an existing entry
    public function update(Request $request, $id)
    {
        $validated = $request->validate([
            'label' => 'required|array|min:1',
            'amount' => 'required|array|min:1',
            'label.*' => 'required|string',
            'amount.*' => 'required|numeric|min:0.01',
        ]);

        // Find the existing entry
        $entry = Entry::findOrFail($id);

        // Combine label and amount into an array of entries
        $entries = [];
        foreach ($validated['label'] as $index => $label) {
            $entries[] = [
                'label' => $label,
                'amount' => $validated['amount'][$index],
            ];
        }

        // Update the existing entry
        $entry->data = $entries;
        $entry->save();

        return redirect()->route('entries.index')->with('success', 'Entry updated successfully!');
    }

    // Delete an entry
    public function destroy($id)
    {
        $entry = Entry::find($id);

        if ($entry) {
            $entry->delete();
            return response()->json(['success' => 'Entry deleted successfully']);
        }

        return response()->json(['error' => 'Entry not found'], 404);
    }
}

